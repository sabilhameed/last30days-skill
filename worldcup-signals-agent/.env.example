# Copy to .env and fill in. Nothing here is required for a --mock run.

# --- Signal extraction (Claude) ---
# Without a key the agent uses the deterministic heuristic extractor.
ANTHROPIC_API_KEY=
# Model used for extraction (defaults to the most capable Opus).
WORLDCUP_AGENT_MODEL=claude-opus-4-8

# --- Engine wiring ---
# Path to the last30days skill dir (defaults to ../skills/last30days in this repo).
LAST30DAYS_SKILL_DIR=
# Python 3.12+ interpreter for the engine (auto-detected if unset).
LAST30DAYS_PYTHON=

# --- Storage / behavior ---
WORLDCUP_AGENT_DB=./data/worldcup_signals.duckdb
WORLDCUP_AGENT_MOCK=
WORLDCUP_AGENT_NO_LLM=

# --- Optional: richer engine sourcing (passed through to last30days) ---
# See ../CONFIGURATION.md in the skill repo for the full list.
# SCRAPECREATORS_API_KEY=
# BRAVE_API_KEY=
